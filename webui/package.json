{
    "name": "mecha-webui",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx server/src/main.ts",
        "dev:client": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "test": "vitest run --config vitest.config.ts",
        "test:coverage": "vitest run --config vitest.config.ts --coverage",
        "test:watch": "vitest --config vitest.config.ts",
        "runner:build": "docker build -t mecha-codex-runner:base -f runner/Dockerfile runner",
        "runner:shell": "docker run --rm -it -v \"$PWD/cache:/workspace\" -w /workspace mecha-codex-runner:base /bin/bash"
    },
    "dependencies": {
        "@fastify/multipart": "^9.0.3",
        "@fastify/static": "^8.1.1",
        "@fastify/websocket": "^11.0.2",
        "@xterm/addon-fit": "^0.10.0",
        "@xterm/xterm": "^5.5.0",
        "fastify": "^5.2.1",
        "node-pty": "^1.1.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "yaml": "^2.7.0"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.2",
        "@types/node": "^22.13.5",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/coverage-v8": "^3.0.5",
        "jsdom": "^29.1.1",
        "tsx": "^4.19.3",
        "typescript": "^5.7.3",
        "vite": "^6.1.1",
        "vitest": "^3.0.5"
    },
    "engines": {
        "node": ">=22.5"
    }
}
